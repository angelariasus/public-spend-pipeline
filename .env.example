# Copy to .env and change the secrets before running `docker compose up`.

# --- PostgreSQL (one server: Airflow metadata DB + analytics warehouse) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-airflow
POSTGRES_HOST_PORT=5433

WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change-me-warehouse

# Read-only role for BI tools (Metabase now, Power BI later): SELECT on marts.
BI_READER_USER=bi_reader
BI_READER_PASSWORD=change-me-bi-reader

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me-jwt-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Metabase (http://localhost:3000) ---
METABASE_DB=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change-me-metabase-db
# Encrypts the database credentials Metabase stores. Generate like the JWT secret.
METABASE_ENCRYPTION_KEY=change-me-metabase-encryption-key
# Admin account created by the metabase-provision service.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me-metabase-admin1

# --- OECE ingestion scope (YYYY-MM; empty end = latest published month) ---
OECE_START_PERIOD=2024-01
OECE_END_PERIOD=
